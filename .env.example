# Server Configuration
PORT=8081
# Comma-separated browser origins allowed to call POST /snap.
# Leave empty to reject all cross-origin requests.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Public origin used to build shareable links in POST /snap responses.
# Leave empty to derive it from the request Host/Proto.
PUBLIC_BASE_URL=http://localhost:8081
# Database Configuration
# PostgreSQL connection string
# Format: postgres://username:password@localhost:5432/database_name
DATABASE_URL=postgres://user:password@localhost:5432/snap_link
# Neon Managed Better Auth base URL (per-branch, Console → Branch → Auth)
# Format: https://ep-xxxxx.aws.neon.tech/dbname/auth
# JWKS + issuer are derived, no second URL needed.
NEON_AUTH_BASE_URL=https://ep-xxxxx.aws.neon.tech/snap_link/auth
