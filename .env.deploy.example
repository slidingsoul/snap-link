# Copy to .env.deploy (gitignored), fill in, then run ./deploy.sh
#
# App runtime values (rendered into app.yaml):

# Pooled Neon URL (host contains "-pooler"), sslmode=require.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.aws.neon.tech/neondb?sslmode=require"

# Neon Console → Branch → Auth, same branch as DATABASE_URL.
NEON_AUTH_BASE_URL="https://ep-xxx.aws.neon.tech/neondb/auth"

# Browser origin(s) allowed to call POST /snap, comma-separated.
# Optional; empty rejects all cross-origin browser requests.
CORS_ALLOWED_ORIGINS="https://your-frontend.example.com"

# Public origin used to build shareable links.
# Optional; deploy.sh defaults it to the app's default hostname.
PUBLIC_BASE_URL=""

# Migrations use the direct (non-pooler) URL. deploy.sh skips them if empty.
DIRECT_DATABASE_URL="postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require"

# Optional: override the gcloud project (defaults to `gcloud config` project).
# PROJECT_ID="project-two-505505"
